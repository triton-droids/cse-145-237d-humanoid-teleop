<mujoco model="ch_robot">
  <compiler angle="radian" coordinate="local" meshdir="meshes"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <default class="leg_motor">
      <joint damping="1.0" frictionloss="0.15" armature="0.01"/>
    </default>
    <default class="ch_robot">
      <geom material="metal_silver"/>
      <site rgba="1 0 0 1" size="0.01" group="5"/>
      <joint frictionloss="0.1" armature="0.005"/>
      <position inheritrange="1" kp="75" kv="5"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
      <default class="contact_surface">
        <geom friction="1.0 0.005 0.0001" solref="0.01 2" solimp="0.9 0.95 0.001"/>
      </default>
    </default>
  </default>

  <asset>
    <!-- Collision meshes -->
    <mesh name="hip"        file="hip_ch.stl"        scale="0.001 0.001 0.001"/>
    <mesh name="left_leg1"  file="left_leg1_ch.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="left_leg2"  file="left_leg2_ch.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="left_leg3"  file="left_leg3_ch.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="left_leg4"  file="left_leg4_ch.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="right_leg1" file="right_leg1_ch.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_leg2" file="right_leg2_ch.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_leg3" file="right_leg3_ch.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_leg4" file="right_leg4_ch.stl" scale="0.001 0.001 0.001"/>

    <!-- Visual meshes -->
    <mesh name="torso_visual"           file="visual/battery_box.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="hip_visual"             file="visual/hip_dumb2.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="left_leg1_visual"       file="visual/left_leg1_dumb.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="left_leg2_visual"       file="visual/left_leg2_dumb.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="left_leg3_visual"       file="visual/left_leg3_dumb.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="left_leg4_visual"       file="visual/left_leg4_dumb.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="left_foot_visual"       file="visual/left_foot.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="left_foot_sole_visual"  file="visual/left_foot_sole.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="right_leg1_visual"      file="visual/right_leg1_dumb.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="right_leg2_visual"      file="visual/right_leg2_dumb.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="right_leg3_visual"      file="visual/right_leg3_dumb.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="right_leg4_visual"      file="visual/right_leg4_dumb.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="right_foot_visual"      file="visual/right_foot.stl"        scale="0.001 0.001 0.001"/>
    <mesh name="right_foot_sole_visual" file="visual/right_foot_sole.stl"   scale="0.001 0.001 0.001"/>

    <material name="metal_silver" rgba="0.55 0.55 0.60 1" specular="1.0" shininess="1.0" reflectance="0.5"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="10 10 0.1" pos="0 0 0"/>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>

    <!-- TORSO - root body with freejoint for floating base -->
    <body name="torso" pos="0 0 0.765" childclass="ch_robot">
      <freejoint/>
      <site name="imu"/>
      <geom class="visual" mesh="torso_visual"/>
      <geom name="torso_collision_box" class="collision" type="box" size="0.14 0.06 0.048"
            pos="-0.154672 -0.03 0.6962" contype="1" conaffinity="1"/>
      <inertial pos="-0.15417 -0.030012 0.697219"
                mass="3.175"
                fullinertia="0.005173 0.01947 0.02099 3.126e-17 1.463904e-6 -1.478e-16"/>

      <!-- HIP -->
      <body name="hip" pos="0 0 0">
        <geom class="collision" type="mesh" mesh="hip" contype="1" conaffinity="1"/>
        <geom class="visual" mesh="hip_visual"/>
        <inertial pos="-0.155587 -0.02906 0.584318"
                  mass="5.159055"
                  fullinertia="0.0156 0.02377 0.02517 0.000178966 0.000001857794 -0.000043706028"/>

        <!-- Anatomical pelvis marker at midpoint of left/right hip pivots.
             Placed inside `hip` body (no joint), so this marker represents the
             true pelvis position regardless of leg joint angles. Used for
             retargeting Pelvis -> pelvis_marker mapping (decouples scale factor
             from torso body origin offset, which is 0.577m below hip pivots). -->
        <body name="pelvis_marker" pos="-0.155636 -0.029495 0.577401"/>

        <!-- ==================== LEFT LEG ==================== -->
        <body name="left_leg1" pos="0 0 0">
          <joint name="left_hip1_joint" type="hinge" axis="1 0 0"
                 range="-1.57 1.57" pos="-0.068372 -0.029495 0.577401" class="leg_motor"/>
          <geom class="collision" type="mesh" mesh="left_leg1" contype="1" conaffinity="1"/>
          <geom class="visual" mesh="left_leg1_visual"/>
          <inertial pos="-0.005945 -0.035287 0.577433"
                    mass="2.189611"
                    fullinertia="0.002609 0.003137 0.003391 0.000081259088 0.000001365266 0.000000223227"/>

          <body name="left_leg2" pos="0 0 0">
            <joint name="left_hip2_joint" type="hinge" axis="0 1 0"
                   range="-1.57 1.57" pos="-0.000048 -0.029495 0.577401" class="leg_motor"/>
            <geom class="collision" type="mesh" mesh="left_leg2" contype="1" conaffinity="1"/>
            <geom class="visual" mesh="left_leg2_visual"/>
            <inertial pos="-0.000018 -0.025475 0.486173"
                      mass="1.709674"
                      fullinertia="0.006082 0.005232 0.002818 0.000025844041 0.000000765045 -0.0005798"/>
            <!-- Anatomical hip marker at hip2-joint pivot: moves with hip1 joint, tracks hip position -->
            <body name="left_hip_marker" pos="-0.000048 -0.029495 0.577401"/>

            <body name="left_leg3" pos="0 0 0">
              <joint name="left_thigh_joint" type="hinge" axis="0 0 1"
                     range="-1.57 1.57" pos="-0.000048 -0.029495 0.463816" class="leg_motor"/>
              <geom class="collision" type="mesh" mesh="left_leg3" contype="1" conaffinity="1"/>
              <geom class="visual" mesh="left_leg3_visual"/>
              <inertial pos="0.005174 -0.030248 0.318931"
                        mass="3.156742"
                        fullinertia="0.009368 0.0081 0.004377 0.000046968418 0.0002014 -0.000049473856"/>

              <body name="left_leg4" pos="0 0 0">
                <joint name="left_knee_joint" type="hinge" axis="1 0 0"
                       range="-1.57 1.57" pos="-0.000048 -0.029495 0.306338" class="leg_motor"/>
                <geom class="collision" type="mesh" mesh="left_leg4" contype="1" conaffinity="1"/>
                <geom class="visual" mesh="left_leg4_visual"/>
                <inertial pos="0.001337 -0.031134 0.183938"
                          mass="1.980828"
                          fullinertia="0.01171 0.01193 0.002972 -0.000022781438 0.0002839 -0.0002341"/>
                <!-- Anatomical knee marker at knee-joint pivot: moves with hip1/hip2/thigh joints -->
                <body name="left_knee_marker" pos="-0.000048 -0.029495 0.306338"/>

                <body name="left_foot" pos="0 0 0">
                  <joint name="left_ankle_joint" type="hinge" axis="1 0 0"
                         range="-1.57 1.57" pos="0.00958 -0.03 0.031528" class="leg_motor"/>
                  <!-- Anatomical ankle marker at ankle-joint pivot: moves with all leg joints -->
                  <body name="left_ankle_marker" pos="0.00958 -0.03 0.031528"/>
                  <geom name="left_foot_collision_box" class="contact_surface" type="box"
                        size="0.04 0.105 0.00763" pos="-0.00042 -0.005 -0.0045"
                        contype="1" conaffinity="1"/>
                  <geom class="visual" mesh="left_foot_visual"/>
                  <geom class="visual" mesh="left_foot_sole_visual" pos="0.30958 0 0"/>
                  <inertial pos="-0.00053 -0.020276 0.011109"
                            mass="0.765723"
                            fullinertia="0.002071 0.0004678 0.002213 -0.000017795772 0.000002818065 0.0001167"/>

                  <!-- Foot contact spheres for retargeting foot-sticking constraint -->
                  <body name="left_foot_sphere_1_link" pos="0.03 -0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                  <body name="left_foot_sphere_2_link" pos="-0.03 -0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                  <body name="left_foot_sphere_3_link" pos="0.03 0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                  <body name="left_foot_sphere_4_link" pos="-0.03 0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>

        <!-- ==================== RIGHT LEG ==================== -->
        <body name="right_leg1" pos="0 0 0">
          <joint name="right_hip1_joint" type="hinge" axis="1 0 0"
                 range="-1.57 1.57" pos="-0.24290 -0.029495 0.577401" class="leg_motor"/>
          <geom class="collision" type="mesh" mesh="right_leg1" contype="1" conaffinity="1"/>
          <geom class="visual" mesh="right_leg1_visual"/>
          <inertial pos="-0.305326 -0.035287 0.577434"
                    mass="2.189548"
                    fullinertia="0.002609 0.003137 0.003391 -0.000081252869 -0.00000135392 0.00000024481"/>

          <body name="right_leg2" pos="0 0 0">
            <joint name="right_hip2_joint" type="hinge" axis="0 1 0"
                   range="-1.57 1.57" pos="-0.311223 -0.029495 0.577401" class="leg_motor"/>
            <geom class="collision" type="mesh" mesh="right_leg2" contype="1" conaffinity="1"/>
            <geom class="visual" mesh="right_leg2_visual"/>
            <inertial pos="-0.311252 -0.025506 0.485714"
                      mass="1.72284"
                      fullinertia="0.006132 0.005281 0.002822 -0.000025837194 -0.000000742612 -0.000583"/>

            <!-- Anatomical hip marker at hip2-joint pivot: moves with hip1 joint, tracks hip position -->
            <body name="right_hip_marker" pos="-0.311223 -0.029495 0.577401"/>

            <body name="right_leg3" pos="0 0 0">
              <joint name="right_thigh_joint" type="hinge" axis="0 0 1"
                     range="-1.57 1.57" pos="-0.311223 -0.029495 0.463816" class="leg_motor"/>
              <geom class="collision" type="mesh" mesh="right_leg3" contype="1" conaffinity="1"/>
              <geom class="visual" mesh="right_leg3_visual"/>
              <inertial pos="-0.317293 -0.030266 0.31875"
                        mass="3.074969"
                        fullinertia="0.009174 0.007824 0.004262 -0.000045044639 -0.0002255 -0.000049133206"/>

              <body name="right_leg4" pos="0 0 0">
                <joint name="right_knee_joint" type="hinge" axis="1 0 0"
                       range="-1.57 1.57" pos="-0.311223 -0.029495 0.306338" class="leg_motor"/>
                <geom class="collision" type="mesh" mesh="right_leg4" contype="1" conaffinity="1"/>
                <geom class="visual" mesh="right_leg4_visual"/>
                <inertial pos="-0.312608 -0.031134 0.183938"
                          mass="1.980828"
                          fullinertia="0.01171 0.01193 0.002972 0.000022781459 -0.0002839 -0.0002341"/>
                <!-- Anatomical knee marker at knee-joint pivot: moves with hip1/hip2/thigh joints -->
                <body name="right_knee_marker" pos="-0.311223 -0.029495 0.306338"/>

                <body name="right_foot" pos="0 0 0">
                  <joint name="right_ankle_joint" type="hinge" axis="1 0 0"
                         range="-1.57 1.57" pos="-0.320851 -0.03 0.031528" class="leg_motor"/>
                  <!-- Anatomical ankle marker at ankle-joint pivot: moves with all leg joints -->
                  <body name="right_ankle_marker" pos="-0.320851 -0.03 0.031528"/>
                  <geom name="right_foot_collision_box" class="contact_surface" type="box"
                        size="0.04 0.105 0.00763" pos="-0.310851 -0.005 -0.0045"
                        contype="1" conaffinity="1"/>
                  <geom class="visual" mesh="right_foot_visual"/>
                  <geom class="visual" mesh="right_foot_sole_visual" pos="-0.310851 0 0"/>
                  <inertial pos="-0.310741 -0.020276 0.011109"
                            mass="0.765723"
                            fullinertia="0.002071 0.0004678 0.002213 0.000017795772 -0.000002818065 0.0001167"/>

                  <!-- Foot contact spheres for retargeting foot-sticking constraint -->
                  <body name="right_foot_sphere_1_link" pos="0.03 -0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                  <body name="right_foot_sphere_2_link" pos="-0.03 -0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                  <body name="right_foot_sphere_3_link" pos="0.03 0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                  <body name="right_foot_sphere_4_link" pos="-0.03 0.08 -0.008">
                    <geom type="sphere" size="0.005" contype="1" conaffinity="1" group="3"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>

      </body>
    </body>
  </worldbody>

  <!-- Actuators -->
  <actuator>
    <position name="left_hip1_act"   joint="left_hip1_joint"   kp="100" kv="1" forcerange="-120 120"/>
    <position name="left_hip2_act"   joint="left_hip2_joint"   kp="100" kv="1" forcerange="-120 120"/>
    <position name="left_thigh_act"  joint="left_thigh_joint"  kp="100" kv="1" forcerange="-120 120"/>
    <position name="left_knee_act"   joint="left_knee_joint"   kp="80"  kv="1" forcerange="-120 120"/>
    <position name="left_ankle_act"  joint="left_ankle_joint"  kp="20"  kv="1" forcerange="-120 120"/>
    <position name="right_hip1_act"  joint="right_hip1_joint"  kp="100" kv="1" forcerange="-120 120"/>
    <position name="right_hip2_act"  joint="right_hip2_joint"  kp="100" kv="1" forcerange="-120 120"/>
    <position name="right_thigh_act" joint="right_thigh_joint" kp="100" kv="1" forcerange="-120 120"/>
    <position name="right_knee_act"  joint="right_knee_joint"  kp="80"  kv="1" forcerange="-120 120"/>
    <position name="right_ankle_act" joint="right_ankle_joint" kp="20"  kv="1" forcerange="-120 120"/>
  </actuator>

  <!-- Contact exclusions for adjacent bodies -->
  <contact>
    <exclude body1="torso" body2="hip"/>
    <exclude body1="hip" body2="left_leg1"/>
    <exclude body1="left_leg1" body2="left_leg2"/>
    <exclude body1="left_leg2" body2="left_leg3"/>
    <exclude body1="left_leg3" body2="left_leg4"/>
    <exclude body1="left_leg4" body2="left_foot"/>
    <exclude body1="hip" body2="right_leg1"/>
    <exclude body1="right_leg1" body2="right_leg2"/>
    <exclude body1="right_leg2" body2="right_leg3"/>
    <exclude body1="right_leg3" body2="right_leg4"/>
    <exclude body1="right_leg4" body2="right_foot"/>
  </contact>

</mujoco>
